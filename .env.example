# Local Studio Configuration
# Copy this file to .env (gitignored). Never commit secrets.
# Run `npm run doctor` to preflight the application toolchain before first launch.

# =============================================================================
# Distributed LLM lab (NEW VM)
# =============================================================================

OLD_PC_HOST=192.168.0.69
OLD_PC_LOCAL_STUDIO_URL=http://192.168.0.69:8080
OLD_PC_LOCAL_STUDIO_API_KEY=
OLD_PC_MODEL_NAME=gemma-4-e4b-it-q4km
OLD_PC_MODEL_QUANTIZATION=Q4_K_M

NEW_VM_PUBLIC_HOST=192.168.0.230
FRONTEND_PORT=4783
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
ALLOWED_LAN_HOSTS=true

# =============================================================================
# Controller Settings (OLD PC inference node)
# =============================================================================

LOCAL_STUDIO_HOST=127.0.0.1
LOCAL_STUDIO_PORT=8080

# REQUIRED when LOCAL_STUDIO_HOST is non-loopback (e.g. 0.0.0.0 or a LAN IP).
LOCAL_STUDIO_API_KEY=

# LOCAL_STUDIO_ALLOW_UNAUTHENTICATED=false
# LOCAL_STUDIO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.0.230:4783

# LOCAL_STUDIO_ALLOW_CUSTOM_LAUNCH_COMMAND=false
# LOCAL_STUDIO_DEFAULT_TRUST_REMOTE_CODE=true

LOCAL_STUDIO_INFERENCE_HOST=127.0.0.1
LOCAL_STUDIO_INFERENCE_PORT=8081

# =============================================================================
# Paths
# =============================================================================

# LOCAL_STUDIO_MODELS_DIR=/models
LOCAL_STUDIO_DATA_DIR=./data

# =============================================================================
# Backend-specific Settings (Optional)
