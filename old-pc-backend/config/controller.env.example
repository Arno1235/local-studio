# Copy to the repository root as .env.local (gitignored). Never commit secrets.

# Bind the controller to the old PC LAN address, not 0.0.0.0 (avoids Docker bridges).
LOCAL_STUDIO_HOST=192.168.0.69
LOCAL_STUDIO_PORT=8080

# Required for any non-loopback bind. Send as Authorization: Bearer <key> or X-API-Key.
LOCAL_STUDIO_API_KEY=replace-with-openssl-rand-hex-32

# llama.cpp listens on loopback; the controller proxies /v1.
LOCAL_STUDIO_INFERENCE_HOST=127.0.0.1
LOCAL_STUDIO_INFERENCE_PORT=8081

LOCAL_STUDIO_DATA_DIR=/home/anon/.local/share/local-studio/data
LOCAL_STUDIO_MODELS_DIR=/home/anon/.local/share/local-studio/models
LOCAL_STUDIO_LLAMA_BIN=/home/anon/.local/share/local-studio/data/runtime/llamacpp/src/build/bin/llama-server

# Comma-separated browser origins for the new-VM frontend.
LOCAL_STUDIO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4783,http://127.0.0.1:4783,http://192.168.0.196:3000,http://192.168.0.196:4783

CUDA_HOME=/usr/local/cuda

# Optional Hugging Face token for gated/private downloads (also LOCAL_STUDIO_HF_TOKEN).
# HF_TOKEN=
# LOCAL_STUDIO_HF_TOKEN=
